<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_transfer_handling_unit_line_form" model="ir.ui.view">
        <field name="name">view_transfer_handling_unit_line_form</field>
        <field name="model">transfer.handling.unit.line</field>
        <field name="arch" type="xml">
            <form string="Description" create="false">
                <header>
                    <button type="object" name="action_confirm" string="Confirm" class="btn btn-primary" data-hotkey="q"/>
                </header>
                <sheet>
                    <field name="name" invisible="1"/>
                    <group>
                        <field name="transfer_handling_unit_ids" nolabel="1" mode="tree">
                            <tree editable="bottom" create="0" edit="1" decoration-info="need_to_update == True" decoration-danger="product_not_found == True">
                                <field name="picking_id" readonly="1" force_save="1"/>
                                <field name="partner_id" readonly="1" force_save="1"/>
                                <field name="scheduled_date" readonly="1" force_save="1"/>
                                <field name="origin" readonly="1" force_save="1"/>
                                <field name="product_code"/>
                                <field name="need_to_update" invisible="1"/>
                                <field name="product_not_found" invisible="1"/>
                                <field name="error_msg" optional="hide"/>                                
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_transfer_handling_unit" model="ir.actions.act_window">
        <field name="name">Handling Unit</field>
        <field name="res_model">transfer.handling.unit.line</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="transfer_product_update.view_transfer_handling_unit_line_form"/>
        <field name="target">current</field>
        <field name="binding_model_id" ref="model_transfer_handling_unit_line"/>
        <field name="binding_view_types">form</field>
    </record>

    <menuitem id="menu_transfer_handling_unit"
        sequence="150"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_transfer_handling_unit"/>
</odoo>

