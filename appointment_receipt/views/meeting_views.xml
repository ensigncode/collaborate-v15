<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_calendar_event_appointment_receipt_inherited" model="ir.ui.view">
            <field name="name">calendar.event.form.appointment.receipts</field>
            <field name="model">calendar.event</field>
            <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <field name="attendee_id" invisible="1"/>
                    <page name="receipt" string="Receipt">
                        <button name="print_prescription"
                                style="background-color: lightblue;border-block-color: black;width: 13%;font-size: 132%;"
                                string="Print" type="object" icon="fa-print text-primary"/>
                        <h2 class="text-muted " style="text-align: -webkit-center;">Lensa RO <field class="col-5 p-2" style="width: auto;" name="location"/></h2>
                        <h1 style="text-align: -webkit-center;">PRESCRIPTIE OPTOMETRICA
                            <span t-field="prescription_code"/>
                        </h1>
                        <h3 style="text-align: -webkit-center;"><field name="attendee_id"/> - varsta: <field class="col-1" name="varsta"/> ani</h3>
                        <br/>
                        <div class="row" style="font-size: 18px;">
                            <div class="col-1"></div>
                            <div class="col-7" style="border-right: 1px solid lightgrey;">
                                <table class="table table-bordered" style="width:100%;">
                                    <thead style="display: table-row-group">
                                        <tr>
                                            <th colspan="2"></th>
                                            <th>SF</th>
                                            <th>CIL</th>
                                            <th>AX</th>
                                            <th>Dp</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td rowspan="2" style="text-align: -webkit-center;vertical-align: inherit;">V.D.</td>
                                            <td>O.D.</td>
                                            <td><field name="vd_od_sf"/></td>
                                            <td><field name="vd_od_cil"/></td>
                                            <td><field name="vd_od_ax"/></td>
                                            <td rowspan="2" style="text-align: -webkit-center;vertical-align: inherit;"><field name="vd_dp"/></td>
                                        </tr>
                                        <tr>
                                            <td>O.S.</td>
                                            <td><field name="vd_os_sf"/></td>
                                            <td><field name="vd_os_cil"/></td>
                                            <td><field name="vd_os_ax"/></td>
                                        </tr>
                                        <tr>
                                            <td rowspan="2" style="text-align: -webkit-center;vertical-align: inherit;">V.A.</td>
                                            <td>O.D.</td>
                                            <td><field name="va_od_sf"/></td>
                                            <td><field name="va_od_cil"/></td>
                                            <td><field name="va_od_ax"/></td>
                                            <td rowspan="2" style="text-align: -webkit-center;vertical-align: inherit;"><field name="va_dp"/></td>
                                        </tr>
                                        <tr>
                                            <td>O.S.</td>
                                            <td><field name="va_os_sf"/></td>
                                            <td><field name="va_os_cil"/></td>
                                            <td><field name="va_os_ax"/></td>
                                        </tr>
                                    </tbody>

                                </table>
                            </div>
                            <div class="col-3" style="align-self: center;">
                                <table class="table table-borderless" border="0">
                                    <tbody>
                                        <tr>
                                            <td class="float-right">A.V. F.C.: O.D.</td>
                                            <td><field name="av_fc_od"/></td>
                                        </tr>
                                        <tr>
                                            <td class="float-right">A.V. F.C.: O.S.</td>
                                            <td><field name="av_fc_os"/></td>
                                        </tr>
                                        <tr>
                                            <td class="float-right">A.V. C.C.: O.D.</td>
                                            <td><field name="av_cc_od"/></td>
                                        </tr>
                                        <tr>
                                            <td class="float-right">A.V. C.C.: O.S.</td>
                                            <td><field name="av_cc_os"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-1"></div>
                        </div>
                        <div class="row" style="font-size: 18px;">
                            <div class="col-1"></div>
                            <div class="container col-10">
                              <div class="row">
                                <div class="col m-2">DIAGNOSTIC: <field class="ml-1 col-6" name="diagnostic"/></div>
                                <div class="col m-2">RECOMANDARE: <field class="ml-1 col-6" name="recomandare"/></div>
                                <div class="w-100"></div>
                                <div class="col m-2">Date: <field class="ml-1 col-6" name="prescription_date"/></div>
                                <div class="col m-2">Optometrist: <field class="ml-1 col-6" name="optometrist_id" options="{'no_create_edit': True}"/></div>
                              </div>
                            </div>
                            <div class="col-1"></div>
                        </div>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>