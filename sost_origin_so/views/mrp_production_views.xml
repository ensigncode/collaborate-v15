<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Production Form View Inherited -->
    <record id="mrp_production_form_inherited" model="ir.ui.view">
        <field name="name">mrp_production_form_inherited</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position='after'>
                <field name="order_id" invisible="1"/>
                <field name="expected_date" invisible="1"/>
                <field name="partner_id" invisible="1"/>
                <field name="initial_qty" invisible="1"/>
                <field name="client_order_ref" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='miscellaneous']//group/group/field[@name='date_deadline']" position='after'>
                <field name="order_id"/>
            </xpath>
            
        </field>
    </record>

    <!-- Production Tree View Inherited -->
    <record id="mrp_production_tree_inherited" model="ir.ui.view">
        <field name="name">mrp_production_tree_inherited</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position='after'>
                <field name="order_id" optional="hide"/>
                <field name="client_order_ref"/>
                <field name="partner_id"/>
                <field name="expected_date"/>
                <field name="initial_qty"/>
            </xpath>
        </field>
    </record>
</odoo>
