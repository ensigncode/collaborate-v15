<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_invoice_document_extend" inherit_id="account.report_invoice_document">
            <xpath expr="//t[@t-set='address']" position="replace">
                <t t-set="address">
                    <strong>Client:</strong>
                    <span t-field="o.partner_id"
                        t-options='{"widget": "contact", "fields": [ "name"], "no_marker": True}'
                        groups="sale.group_delivery_invoice_address" />
                    <strong>Address:</strong>
                    <span t-field="o.partner_id"
                        t-options='{"widget": "contact", "fields": ["address"   ], "no_marker": True}'
                        groups="sale.group_delivery_invoice_address" />
                    <t t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                        <t t-set="information_block">
                            <div groups="sale.group_delivery_invoice_address"
                                name="shipping_address_block">
                                <strong>Supplier:</strong>
                                <div t-field="o.partner_shipping_id"
                                    t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' />
                            </div>
                        </t>
                    </t>
                    <div t-if="o.partner_id.vat" class="mt16">
                        <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                            t-esc="o.company_id.account_fiscal_country_id.vat_label"
                            id="inv_tax_id_label" />
            <t t-else="">Tax ID</t>: <span
                            t-field="o.partner_id.vat" /></div>
                </t>
            </xpath>
           
           
            <xpath expr="//div[hasclass('page')]/h2" position="attributes">
                <attribute name="class">text-center</attribute>
            </xpath>
            <xpath expr="//div[hasclass('page')]/h2/span[last()]" position="replace">
                <br />
                <span> Original </span>
            </xpath>
            <xpath expr="//div[@name='invoice_date']" position="replace">
                <div></div>
            </xpath>
            <xpath expr="//div[@name='due_date']" position="replace">
                <div></div>
            </xpath>
            <xpath expr="//div[hasclass('page')]/h2" position="after">
                
               <div class="row">
                <div class="col-5 offset-md-6">
                    <strong>
                        <span>Number :</span>
                        <span t-if="o.name != '/'" t-field="o.name"/>
                    </strong>
                    <br />
                    <strong>
                        <span>Date :</span>
                        <span class="m-0" t-field="o.invoice_date"/>
                    </strong>
                </div>
                </div>
                
            </xpath>
            <xpath expr="//th[@name='th_description']" position="replace">
                <th name="th_description" class="text-left">
                    <span>Type of the goods or services</span>
                </th>
            </xpath>
            <xpath expr="//th[@name='th_priceunit']" position="replace">
                <th name="th_priceunit" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                    <span>Price (BGN)</span></th>
            </xpath>
            <xpath expr="//th[@name='th_price_unit']" position="replace">
                <th name="th_price_unit" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                    <span>Discount(BGN)</span>
                </th>
            </xpath>
            <xpath expr="//th[@name='th_subtotal']" position="replace">
                <th name="th_subtotal" class="text-right">
                    <span groups="account.group_show_line_subtotals_tax_excluded">Value(BGN)</span>
                    <span groups="account.group_show_line_subtotals_tax_included">Value(BGN)</span>
                </th>
            </xpath>
            <xpath expr="//t[@t-if='len(payments_vals) > 0']" position="after">
                <tr  class="font-weight-bold">
                    <td>
                        Amount (written in words) :
                    </td>
                    <td class="text-right">
                        <span t-field="o.number_to_words"></span>
                    </td>
                </tr>
                
            </xpath>
            <xpath expr="//div[@name='comment']" position="after">
                <br />
                <div class="row">
                    <div class="col-6">
                        <span>Date of the tax event: </span>
                        <span t-field="o.invoice_date" />
                    </div>
                    <div class="col-6">
                        <span>Payment method: </span>
                        <span t-field="o.payment_id" />
                    </div>
                </div>
                <br /><br />
                <div class="row mt32">
                    <div class="col-12">
                        <span>Signature of the issuer:.......................................</span>
                    </div>
                </div>
            </xpath>
           
        </template>
        <template id="document_tax_totals_extend" inherit_id="account.document_tax_totals">
            <xpath expr="//t" position="replace">
                <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                    <tr class="border-black o_subtotal">
                        <td><strong>Tax base</strong></td>
    
                        <td class="text-right">
                            <span
                                t-att-class="oe_subtotal_footer_separator"
                                t-esc="subtotal['formatted_amount']"
                            />
                        </td>
                    </tr>
    
                    <t t-set="subtotal_to_show" t-value="subtotal['name']"/>
                    <t t-call="account.tax_groups_totals"/>
                </t>
               
            </xpath>
            <xpath expr="//tr" position="replace">
                <tr class="border-black o_total">
                    <td><strong>Total amount</strong></td>
                    <td class="text-right">
                        <span t-esc="tax_totals['formatted_amount_total']"/>
                    </td>
                </tr>
            </xpath>
        </template>
    </data>
</odoo>