<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="invoice_report_template">
            <t t-call="web.external_layout">
                <t t-set="l" t-value="o.with_context(lang=o.partner_id.lang)" />
                <table>
                    <tbody>
                        <tr>
                            <td style="width: 10%"></td>
                            <td style="width: 20%"></td>
                            <td style="width: 30%"></td>
                            <td style="width: 10%"></td>
                            <td style="width: 10%"></td>
                            <td style="width: 10%"></td>
                            <td style="width: 10%"></td>
                        </tr>
                        <tr>
                            <td colspan="2"
                                style="border: 3px solid #000; background-color: lightgrey; padding-top: -200px;">
                                <strong>Доставчик/Supplier:</strong>
                                <span t-esc="o.company_id.name"/>
                                <strong>Адрес/Address:</strong>
                                <t t-esc="o.company_id.street"/>
                                <span t-if="o.company_id.street and ( o.company_id.street2 or o.company_id.city or o.company_id.state_id.name or o.company_id.zip or o.company_id.country_id.name)">
                                    ,
                                </span>
                                <t t-esc="o.company_id.street2"/>
                                <span t-if="o.company_id.street2 and ( o.company_id.city or o.company_id.state_id.name or o.company_id.zip or o.company_id.country_id.name)">
                                    ,
                                </span>
                                <br/>
                                <strong>Ид. номер по ДДС/VAT Number:</strong>
                                <span t-if="o.company_id.vat" class="mt16">
                                    <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                                       t-esc="o.company_id.account_fiscal_country_id.vat_label"
                                       id="inv_tax_id_label"/>
                                </span>
                                <br/>
                                <strong>ЕИК/ID number:</strong>
                                <span t-esc="o.company_id.company_registry"/>
                                <br/>
                                <t t-set="bank_ids"
                                   t-value="o.company_id.partner_id.bank_ids.sorted('sequence', reverse=True)"/>
                                <t t-if="bank_ids">
                                    <strong>Bank name:</strong>
                                    <span t-esc="bank_ids[0].bank_name"/>
                                    <br/>
                                    <strong>Bank Account Number:</strong>
                                    <span t-esc="bank_ids[0].acc_number"/>
                                </t>
                            </td>
                            <td colspan="2" style="border-bottom: 3px solid #fff; padding-top: -200px;">
                                &amp;nbsp;
                            </td>
                            <td colspan="3"
                                style="border: 3px solid #000; background-color: lightgrey; padding-top: -200px;">
                                <strong>Получател/Client:</strong>
                                <span t-esc="o.partner_id"
                                      t-options='{"widget": "contact", "fields": ["name"], "no_marker": True}'
                                      groups="sale.group_delivery_invoice_address"/>
                                <strong>Адрес/Address:</strong>
                                <span t-esc="o.partner_id"
                                      t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'
                                      groups="sale.group_delivery_invoice_address"/>
                                <strong>Ид. номер по ДДС/VAT number:</strong>
                                <span t-if="o.partner_id.vat" class="mt16">
                                    <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                                       t-esc="o.company_id.account_fiscal_country_id.vat_label"
                                       id="inv_tax_id_label"/>
                                </span>
                                <br/>
                                <t t-set="partner_bank_ids"
                                   t-value="o.partner_id.bank_ids.sorted('sequence', reverse=True)"/>
                                <t t-if="partner_bank_ids">
                                    <strong>Bank name:</strong>
                                    <span t-esc="partner_bank_ids[0].bank_id.name"/>
                                    <br/>
                                    <strong>BIC:</strong>
                                    <span t-esc="partner_bank_ids[0].bank_bic"/>
                                    <br/>
                                    <strong>IBAN:</strong>
                                    <span t-esc="partner_bank_ids[0].acc_number"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="7">
                                <h4 class="text-center" style="text-decoration: underline;">
                                    ФАКТУРА/INVOICE
                                </h4>
                                <h4 class="text-center">ОРИГИНАЛ/ORIGINAL</h4>
                            </td>
                        </tr>
                        <tr t-if="o.invoice_date">
                            <td colspan="7" class="text-center" style="padding-bottom: 50px;">
                                <b>Номер/Number:</b>
                                <t t-if="o.name != '/'">
                                    <span t-esc="o.name"/>
                                </t>
                                <br/>
                                <b>Дата/Date:</b>
                                <t t-if="o.invoice_date">
                                    <span t-esc="o.invoice_date"/>
                                </t>
                            </td>
                        </tr>
                        <tr class="text-danger"
                            style="border: 3px solid #000;  border-bottom: 0; background-color: lightgrey;">
                            <th style="border: 3px solid #000;  border-left: 0;  border-top: 0;  border-bottom: 0;">
                                No
                            </th>
                            <th colspan="2"
                                style="border: 3px solid #000;  border-right: 0;  border-top: 0;  border-bottom: 0;">
                                Наименование на стоките или услугите/ Type of the goods
                                or services
                            </th>
                            <th style="border: 3px solid #000;  border-left: 0;  border-right: 0; border-top: 0;  border-bottom: 0;">
                                Количество/ Quantity
                            </th>
                            <th style="border: 3px solid #000;  border-left: 0;  border-top: 0;  border-bottom: 0;">
                                Ед. Цена/ Price (BGN)
                            </th>
                            <th style="border: 3px solid #000;  border-right: 0; border-top: 0;  border-bottom: 0;">
                                Отстъпка/ Discount (BGN)
                            </th>
                            <th style="border: 3px solid #000;  border-right: 0; border-top: 0;  border-bottom: 0;">
                                Value (BGN)
                            </th>
                        </tr>
                        <t t-set="i" t-value="1"/>
                        <t t-foreach="o.invoice_line_ids" t-as="product">
                            <tr>
                                <td style="border: 3px solid #000;  border-top: 0;  border-bottom: 0;">
                                    <span t-esc="i"/>
                                </td>
                                <td colspan="2"
                                    style="border: 3px solid #000;  border-right: 0;  border-top: 0;  border-bottom: 0;">
                                    <span t-esc="product.product_id.name"/>
                                </td>
                                <td style="border: 3px solid #000;  border-left: 0;  border-right: 0; border-top: 0;  border-bottom: 0; ">
                                    <span t-esc="product.quantity"/>
                                </td>
                                <td style="border: 3px solid #000;  border-left: 0;  border-top: 0;  border-bottom: 0;">
                                    <span t-esc="product.price_unit"/>
                                </td>
                                <td style="border: 3px solid #000;  border-right: 0; border-top: 0;  border-bottom: 0;">
                                    <span t-esc="product.discount"/>
                                </td>
                                <td style="border: 3px solid #000; border-top: 0;  border-bottom: 0;">
                                    <span t-esc="product.price_total"/>
                                </td>
                                <t t-set="i" t-value="i+1"/>
                            </tr>
                        </t>
                        <tr>
                            <td colspan="2"
                                style="border: 3px solid #000;  border-right: 0; border-left: 0;  border-bottom: 0;">
                                &amp;nbsp;
                            </td>
                            <t t-set="tax_totals" t-value="json.loads(o.tax_totals_json)"/>
                            <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                                <td colspan="4"
                                    style="border: 3px solid #000;  border-right: 0;  border-bottom: none;">
                                    Данъчна основа/Tax base:
                                </td>
                                <td class="text-right"
                                    style="border: 3px solid black; border-left: none; border-bottom: none;">
                                    <span
                                            t-att-class="oe_subtotal_footer_separator"
                                            t-esc="subtotal['formatted_amount']"
                                    />
                                </td>
                            </t>
                        </tr>
                        <t t-set="tax_totals" t-value="json.loads(o.tax_totals_json)"/>
                        <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                            <t t-set="subtotal_to_show" t-value="subtotal['name']"/>
                            <t t-foreach="tax_totals['groups_by_subtotal'][subtotal_to_show]"
                               t-as="amount_by_group">
                                <tr>
                                    <td colspan="2">
                                        &amp;nbsp;
                                    </td>
                                    <t t-if="len(tax_totals['groups_by_subtotal'][subtotal_to_show]) > 1 or (tax_totals['amount_untaxed'] != amount_by_group['tax_group_base_amount'])">
                                        <td colspan="4"
                                            style="border: 3px solid #000; border-right: 0; border-top: none; border-bottom: none;">
                                            <span>Сума на ДДС, ставка /VAT Amount:</span>
                                        </td>
                                        <td class="text-right o_price_total"
                                            style="border: 3px solid black; border-left: none; border-top: none; border-bottom: none;">
                                            <span class="text-nowrap"
                                                  t-esc="amount_by_group['formatted_tax_group_amount']"/>
                                        </td>
                                    </t>
                                    <t t-else="">
                                        <td colspan="4"
                                            style="border: 3px solid #000; border-right: 0; border-top: none; border-bottom: none;">
                                            <span>Сума на ДДС, ставка /VAT Amount:</span>
                                        </td>
                                        <td class="text-right o_price_total"
                                            style="border: 3px solid black; border-left: none; border-top: none; border-bottom: none;">
                                            <span class="text-nowrap"
                                                  t-esc="amount_by_group['formatted_tax_group_amount']"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </t>
                        <tr>
                            <td colspan="2">&amp;nbsp;</td>
                            <t t-set="tax_totals" t-value="json.loads(o.tax_totals_json)"/>
                            <td colspan="4" style="border: 3px solid #000;  border-right: 0;">
                                Сума за
                                плащане /Total amount:
                            </td>
                            <td class="text-right"
                                style="border:  3px solid black; border-left: none; ">
                                <span t-esc="tax_totals['formatted_amount_total']"/>
                            </td>
                        </tr>
                        <tr>
                            <t t-set="tax_totals" t-value="json.loads(o.tax_totals_json)"/>
                            <td colspan="7" class="text-right">
                                <b>Словом/Amount (written in words):</b>
                                <span t-esc="o.number_to_words"/>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="padding-top: 80px;">
                                <span>Date of the tax event:</span>
                                <span t-field="o.invoice_date"/>
                            </td>
                            <td colspan="3">&amp;nbsp;</td>
                            <td colspan="2" class="text-center" style="padding-top: 80px;">
                                <span>Payment method:</span>
                                <span>Bank Transfer</span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="7" style="padding-top: 100px;">
                                <span>Signature of the issuer:</span>
                                <span class="d-inline-block"
                                      style="width: 100px;border-bottom: 1px dotted #000;"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </template>
    </data>
</odoo>

