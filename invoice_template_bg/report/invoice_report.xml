<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="account.report_invoice_with_payments">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang"/>
                    <t t-set="print_with_payments" t-value="True"/>
                    <t t-if="not o.company_id.report_template_id or not o.company_id.report_template_id.report_name">
                        <t  t-call="account.report_invoice_document" t-lang="lang"/>
                    </t>
                    <t t-elif="o.company_id.report_template_id.report_name == 'account.report_invoice_with_payments'">
                        <t t-call="invoice_template_bg.invoice_report_template" t-lang="lang"/>
                    </t>
                    <t t-else="">
                        <t t-if="o.company_id" t-call="{{o.company_id.report_template_id.report_name}}" t-lang="lang"/>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
