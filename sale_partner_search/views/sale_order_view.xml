<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_inherited_partner_search" model="ir.ui.view">
        <field name="name">sale.order.form.view.partner.search</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="context">{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True, 'sale_customer': True}</attribute>
            </field>
        </field>
    </record>
</odoo>
