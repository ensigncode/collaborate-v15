<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_export_images_form" model="ir.ui.view">
        <field name="name">view.export.images.form</field>
        <field name="model">export.images</field>
        <field name="arch" type="xml">
        	<form>
                <sheet>
                    <group>
                        <h1>
                            Please Confirm To Export Images
                        </h1>
                        <group>
                            <field name="url" required="0" invisible="1"/>
                        </group>
                    </group>
                </sheet>
        		<footer>
                    <button string="Confirm" name="action_confirm" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

     <record id="action_export_images" model="ir.actions.act_window">
        <field name="name">Export Images</field>
        <field name="res_model">export.images</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_export_images_form"/>
    </record>

    <record id="action_export_images_act_window" model="ir.actions.act_window">
        <field name="name">Export Images</field>
        <field name="res_model">export.images</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="export_product_images.view_export_images_form"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="target">new</field>
    </record>

    <record id="action_export_images_act_window" model="ir.actions.act_window">
        <field name="name">Export Images</field>
        <field name="res_model">export.images</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="export_product_images.view_export_images_form"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="target">new</field>
    </record>

    <record id="action_export_images_template" model="ir.actions.act_window">
        <field name="name">Export Images</field>
        <field name="res_model">export.images</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="export_product_images.view_export_images_form"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="target">new</field>
    </record>

</odoo>