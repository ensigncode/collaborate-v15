<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_signup_newsletter" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.signup.newsletter</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='misc']" position="inside">
                <field name="subscribed_to_newsletter"/>
                <field name="subscribed_to_sms"/>
            </xpath>
        </field>
    </record>
</odoo>