<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_merge_po_line_form_sost" model="ir.ui.view">
		<field name="name">view_merge_po_line_form_sost</field>
		<field name="model">merge.po.line</field>
		<field name="arch" type="xml">
			<form string="Merge Purchase Order">
				<field name="po_ids" widget="many2many_tags" invisible="1"/>
				<field name="merge_po_ids" nolabel="1" readonly="1">
					<tree create="0" edit="0">
						<field name="po_id"  readonly="1" force_save="1"/>
						<field name="partner_id"  readonly="1" force_save="1"/>
						<field name="state"  readonly="1" force_save="1"/>
						<field name="merge_po_id"  readonly="1" force_save="1" invisible="1"/>
					</tree>
				</field>
				<footer>
					<button name="merge_pos" string="Merge"
						type="object" class="oe_highlight" />
					<button string="Cancel" class="oe_link" special="cancel" />
				</footer>
			</form>
		</field>
	</record>
	
	<record id="action_merge_po_line" model="ir.actions.act_window">
		<field name="name">Merge Purchase Order</field>
		<field name="res_model">merge.po.line</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
		<field name="binding_model_id" ref="purchase.model_purchase_order"/>
	</record>
</odoo>
