<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_picking_type_inherit" model="ir.ui.view">
        <field name="name">view_picking_type_inherit</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence_id']" position="after">
                <field name="check_existing_stock"/>                
            </xpath>
        </field>
    </record>

    <record id="view_picking_inherit" model="ir.ui.view">
        <field name="name">view_picking_inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="update_demand_qty" string="Update Demand Qty" type="object" class="oe_stat_button" icon="fa-cubes"/>
            </xpath>

        </field>
    </record>
</odoo>
