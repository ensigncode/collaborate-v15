<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_po_analytic_account_inherited" model="ir.ui.view">
            <field name="name">view_po_analytic_account_inherited</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_ref']" position="after">
                    <field name="generate_analytic" attrs="{'readonly':[('state','=','purchase')]}"/>
                    <field name="analytic_account_id" force_save="1" readonly="1" invisible="1"/>  
                </xpath>
            </field>
        </record>
    </data>
</odoo>