<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="template_pricelist_mail" model="mail.template">
            <field name="name">Template Pricelist</field>
            <field name="model_id" ref="product.model_product_pricelist"/>
            <field name="subject">Pricelist Update</field>
            <field name="email_from">{{(user.email_formatted) }}</field>
            <field name="partner_to"></field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello, <br/><br/>
                        Kindly do consider the Pricelist detail information from below:<br/>
                    </p>
                </div>
            </field>
            <field name="report_template" ref="sost_pricelist_mail.action_report_pricelist_mail"/>
            <field name="report_name">Product PriceList</field>
            <field name="lang"></field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>