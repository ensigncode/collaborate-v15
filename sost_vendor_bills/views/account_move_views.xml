<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_account_move_form_inherited" model="ir.ui.view">
		<field name="name">view_account_move_form_inherited</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form" />
		<field name="arch" type="xml">
			<xpath expr="//field[@name='invoice_line_ids']//tree/field[@name='name']"
				position="after">
				<field name="option_type" optional="hide" force_save="1" readonly="1"/>
			</xpath>
		</field>
	</record>
</odoo>





