<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_select_invoice_form" model="ir.ui.view">
        <field name="name">view_select_invoice_form</field>
        <field name="model">invoice.select</field>
        <field name="arch" type="xml">
            <form string="Invoice Export">
                <group>
                    <group>
                        <field name="invoice_ids" widget="many2many_tags" readonly="1" force_save="1"/>
                    </group>
                </group>
                <footer>
                     <button string="Proceed" name="action_proceed" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
           </form>
        </field>
    </record>

    <record id="view_invoice_export_form" model="ir.ui.view">
        <field name="name">view_invoice_export_form</field>
        <field name="model">invoice.export</field>
        <field name="arch" type="xml">
            <form string="Export Invoice">
                <group>
                    <group>
                        <field name="file_upoload" filename="file_name" readonly="1" force_save="1"/>
                        <field name="file_name"  readonly="1" force_save="1" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
           </form>
        </field>
    </record>
   
    <record id="action_invoice_select_form" model="ir.actions.act_window">
        <field name="name">Invoice Export</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">invoice.select</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_select_invoice_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_view_types">list</field>
    </record>
</odoo>
