<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="view_stock_picking_form_inherited" model="ir.ui.view">
		<field name="name">view_stock_picking_form_inherited</field>
		<field name="model">stock.picking</field>
		<field name="inherit_id" ref="stock.view_picking_form"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='origin']" position="after">

				<label for="assign_owner_id" string="Assign Owner"/>
                <div class="o_row">
                    <field name="assign_owner_id" class="text-left" attrs="{'readonly': [('state', 'in', ('done','cancel'))]}"/>
                     <button type="object" name="update_location" string="Update Location" class="oe_link oe_inline"  style="margin: 0px; padding: 0px;" attrs="{'invisible': [('state', '=', 'done')]}" icon="fa-refresh"/>
                </div>
			</xpath>
		</field>
	</record>

	<record id="view_res_partner_form_inherited" model="ir.ui.view">
		<field name="name">view_res_partner_form_inherited</field>
		<field name="model">res.partner</field>
		<field name="inherit_id" ref="base.view_partner_form"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='category_id']" position="after">
				<field name="location_ids" widget="many2many_tags"/>
			</xpath>
		</field>
	</record>
</odoo>