<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_select_pos_form" model="ir.ui.view">
        <field name="name">view_select_pos_form</field>
        <field name="model">pos.select</field>
        <field name="arch" type="xml">
            <form string="POS Export">
                <group>
                    <group>
                        <field name="pos_order_ids" widget="many2many_tags" readonly="1" force_save="1"/>
                    </group>
                </group>
                <footer>
                     <button string="Proceed" name="action_proceed" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
           </form>
        </field>
    </record>

    <record id="view_pos_export_form" model="ir.ui.view">
        <field name="name">view_pos_export_form</field>
        <field name="model">pos.export</field>
        <field name="arch" type="xml">
            <form string="POS Export">
                <group>
                    <group>
                        <field name="file_upload" filename="file_name" readonly="1" force_save="1"/>
                        <field name="file_name"  readonly="1" force_save="1" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
           </form>
        </field>
    </record>
   
    <record id="action_pos_select_form" model="ir.actions.act_window">
        <field name="name">POS Export</field>
        <field name="res_model">pos.select</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_select_pos_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_order"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
