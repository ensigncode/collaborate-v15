<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="view_sale_order_analysis_pivot" model="ir.ui.view">
		<field name="name">sale.order.report.pivot</field>
		<field name="model">sale.order.report</field>
		<field name="arch" type="xml">
			<pivot string="Sales Analysis" sample="1">
				<field name="date" interval="day" type="col"/>
				<field name="categ_id" type="row"/>
				<field name="price_total" type="measure"/>
			</pivot>
		</field>

	</record>


	<record id="action_order_analysis_report" model="ir.actions.act_window">
		<field name="name">Analysis</field>
		<field name="res_model">sale.order.report</field>
		<field name="view_mode">pivot</field>
		<field name="view_id"></field>  <!-- force empty -->
		<field name="search_view_id" ref="view_sale_order_analysis_pivot"/>
		<!--        <field name="context">{'search_default_Sales':1, 'group_by_no_leaf':1,'group_by':[], 'search_default_filter_order_date': 1}</field>-->
	</record>


	<menuitem id="menu_order_analysis_report"
	          name="Analysis"
	          action="action_order_analysis_report"
	          parent="sale.menu_sale_report"
	          sequence="1"/>


</odoo>
