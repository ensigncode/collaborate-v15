<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="change_payment_method_view_form" model="ir.ui.view">
            <field name="name">change.payment.method.view.form</field>
            <field name="model">change.payment.method.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="payment_method_id" options="{'no_create': True, 'no_open': True}" required="1"/>
                            <field name="pos_payment_ids" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <footer>
                            <button string="Process" name="change_payment_method" type="object" class="oe_highlight"/>
                            <button string="Cancel" class="btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
    
    </data>
    

</odoo>
