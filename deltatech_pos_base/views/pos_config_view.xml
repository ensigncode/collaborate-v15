<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pos_config_view_form" model="ir.ui.view">
        <field name="name">pos.config.form.view</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form" />
        <field name="arch" type="xml">

            <div id="posbox_reference" position="after">
                <h2>ECR</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="ecr_type" />
                            <div class="text-muted">
                                Type of electronic cash register
                            </div>
                            <div>
                                <field name="ecr_type" />
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="ecr_trim" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="ecr_trim" />
                            <div class="text-muted" id="invoice_journal">
                                Trim long product name
                            </div>
                            <div class="content-group mt16" attrs="{'invisible': [('ecr_trim', '=', False)]}">
                                <div class="row mt16">
                                    <label string="Trim to" for="ecr_trim_to" class="col-lg-3 o_light_label" />
                                    <field name="ecr_trim_to" attrs="{'required': [('ecr_trim', '=', True)]}" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="file_prefix" />
                            <div class="text-muted">
                                File prefix
                            </div>
                            <div>
                                <field name="file_prefix" />
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="file_ext" />
                            <div class="text-muted">
                                File extension
                            </div>
                            <div>
                                <field name="file_ext" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
