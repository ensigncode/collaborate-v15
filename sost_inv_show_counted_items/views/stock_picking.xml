<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_move_line_inherited" model="ir.ui.view">
        <field name="name">view_stock_move_line_inherited</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id']" position="attributes">
                <attribute name="context">{'transfer_product':1,'default_location_dest_id':location_dest_id,'default_picking_type_id':parent.picking_type_id,'default_product_id':product_id}</attribute>
            </xpath>
        </field>
    </record>

     <record id="view_stock_picking_type_inherited" model="ir.ui.view">
        <field name="name">view_stock_picking_type_inherited</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence_code']" position="after">
                <field name="show_stock"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_inherited" model="ir.ui.view">
        <field name="name">view_stock_picking_inherited</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id']" position="attributes">
                <attribute name="context">{'main_location_dest_id':1,'default_picking_type_id':picking_type_id}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
