<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Define new view for purchase.order model to add a field for scanning barcodes -->
    <record id="view_mrp_form_inherited" model="ir.ui.view">
        <field name="name">view_mrp_form_inherited</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miscellaneous']//group/field[@name='origin']"
                   position="before">
                <field name="sale_order_id"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_mrp_production_filter_inherited">
        <field name="name">view_mrp_production_filter_inherited</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="sale_order_id"/>
            </xpath>

            <xpath expr="//group" position="inside">
                <filter string="Order" name="sale_order_id" domain="[]" context="{'group_by': 'sale_order_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>

