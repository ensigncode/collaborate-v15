<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_putaway_rule_form" model="ir.ui.view">
        <field name="name">view_product_putaway_rule_form</field>
        <field name="model">product.putaway.rule</field>
        <field name="arch" type="xml">
            <form string='Product Putaway Rule'>
                <sheet>
                    <group>
                        <group><field name="po_id" readonly="1" force_save="1" invisible="1"/></group>
                        <group><field name="quant_ids" readonly="1" force_save="1"  invisible="1"/></group>
                    </group>
                    <group>
                        <field name="product_putaway_rule_line_ids" nolabel="1">
                            <tree editable="bottom" decoration-danger="(not location_out_id)" create="0" delete="0">
                                <field name="product_id" readonly="1" force_save="1"/>
                                <field name="location_in_id" readonly="1" force_save="1"/>
                                <field name="location_out_id" attrs="{'required':[('operation_type','=','existing')],'readonly':[('fix_location','=',True)]}"/>
                                <field name="operation_type" required="1"  attrs="{'readonly':[('fix_location','=',True)]}"/>
                                <field name="fix_location" invisible="1"/>
                            </tree>
                        </field>                 
                    </group>
                    <footer>
                        <button string="Confirm" name="action_confirm" type="object" class="btn-primary"/>
                        <button special="cancel" data-hotkey="z" string="Close" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_putaway_rule_form" model="ir.actions.act_window">
        <field name="name">Product Putaway Rule</field>
        <field name="res_model">product.putaway.rule</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_product_putaway_rule_form"/>
        <field name="target">new</field>
    </record>

    <!-- <menuitem
        action="action_update_putaway_rule"
        id="stock_update_putaway_rule"
        name="Update Putaway Rule"
        parent="stock.menu_warehouse_report" sequence="200"/> -->
</odoo>
