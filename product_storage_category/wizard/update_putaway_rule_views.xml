<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_update_putaway_rule_form" model="ir.ui.view">
        <field name="name">view_update_putaway_rule_form</field>
        <field name="model">update.putaway.rule</field>
        <field name="arch" type="xml">
            <form string='Putaway Rule'>
                <group>
                    <group>
                        <field name="operation_type" widget="radio" required="1"/>
                        
                        <field name="company_id" invisible="1"/>
                        <field name="product_id" attrs="{'invisible':[('operation_type','!=','existing')]}"/>
                        <field name="location_in_id" options="{'no_create': True}" groups="stock.group_stock_multi_locations" attrs="{'invisible':[('operation_type','!=','existing')],'required':[('operation_type','=','existing')]}"/>
                        <field name="location_out_id" options="{'no_create': True}" groups="stock.group_stock_multi_locations" attrs="{'invisible':[('operation_type','!=','existing')],'required':[('operation_type','=','existing')]}"/>
                    </group>
                    <group>
                    </group>                    
                </group>

                <footer>
                    <button string="Confirm" name="action_confirm" type="object" class="btn-primary"/>
                    <button special="cancel" data-hotkey="z" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_update_putaway_rule" model="ir.actions.act_window">
        <field name="name">Update Putaway Rule</field>
        <field name="res_model">update.putaway.rule</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_update_putaway_rule_form"/>
        <field name="target">new</field>
    </record>

    <menuitem
        action="action_update_putaway_rule"
        id="stock_update_putaway_rule"
        name="Update Putaway Rule"
        parent="stock.menu_warehouse_report" sequence="200"/>

</odoo>
