<!-- <button name="button_confirm" type="object" states="sent" string="Confirm Order" class="oe_highlight" id="bid_confirm" data-hotkey="v"/>
                    

                    <button name="button_confirm" type="object" states="draft" string="Confirm Order" id="draft_confirm"/> -->
                    
    <record id="view_purchase_order_inherited" model="ir.ui.view">
        <field name="name">view_purchase_order_inherited</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='bid_confirm']" position="replace">
            </xpath>
             <xpath expr="//button[@id='draft_confirm']" position="replace">
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="after">
                <button name="update_po_product_putaway_rule_data" type="object" states="sent" string="Confirm Order" class="oe_highlight" id="bid_confirm" data-hotkey="v"/>
                <button name="update_po_product_putaway_rule_data" type="object" states="draft" string="Confirm Order" id="draft_confirm"/> 
            </xpath>
        </field>
    </record>

    <record id="view_putaway_rule_inherited" model="ir.ui.view">
        <field name="name">view_putaway_rule_inherited</field>
        <field name="model">stock.putaway.rule</field>
        <field name="inherit_id" ref="stock.stock_putaway_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_out_id']" position="after">
               <field name="location_out_storage_category_id" invisible="1"/>
            </xpath>
        </field>
    </record>  

</odoo>
