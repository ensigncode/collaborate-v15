<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_temp_inherited" model="ir.ui.view">
        <field name="name">view_product_temp_inherited</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="after">
                <page name="product_storage_lines" string="Product Storage">
                    <group string="Storage Capacity">
                        <field name="product_storage_line_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="storage_category_id"/>
                                <field name="storage_capacity"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>

