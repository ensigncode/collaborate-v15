<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_temp_inherited" model="ir.ui.view">
        <field name="name">view_product_temp_inherited</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='packaging']" position="before">
                <group string="Storage Capacity">
                    <field name="product_storage_line_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="storage_category_id"/>
                            <field name="storage_capacity"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

 

