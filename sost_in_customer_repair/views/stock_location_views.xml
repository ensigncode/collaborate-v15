<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_location_form_inheriedd" model="ir.ui.view">
		<field name="name">view_location_form_inheried</field>
		<field name="model">stock.location</field>
		<field name="inherit_id" ref="stock.view_location_form" />
		<field name="arch" type="xml">
			<xpath expr="//field[@name='return_location']"
				position="after">
				<field name="repair_type" attrs="{'invisible':[('usage','=','internal')]}"/>
			</xpath>
		</field>
	</record>

	<record id="view_stock_warehouse_form_inheriedd" model="ir.ui.view">
		<field name="name">view_stock_warehouse_form_inheriedd</field>
		<field name="model">stock.warehouse</field>
		<field name="inherit_id" ref="stock.view_warehouse" />
		<field name="arch" type="xml">
			<xpath expr="//field[@name='partner_id']" position="after">
				<field name="repair_location_id" domain="[('repair_type','=','repair')]"/>
				<field name="fixed_location_id" domain="[('repair_type','=','fixed')]"/>
			</xpath>
		</field>
	</record>
</odoo>