<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_appointment_status_tree" model="ir.ui.view">
        <field name="name">view.appointment.status.tree</field>
        <field name="model">appointment.status</field>
        <field name="arch" type="xml">
            <tree string="Appointment Status">
                <field name="name" />
            </tree>
        </field>
    </record>
    <record id="view_appointment_status_form" model="ir.ui.view">
        <field name="name">view.appointment.status.form</field>
        <field name="model">appointment.status</field>
        <field name="arch" type="xml">
            <form string="Appointment Status">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_appointment_status" model="ir.actions.act_window">
        <field name="name">Appointment Status</field>
        <field name="res_model">appointment.status</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="website_appointment_extend.view_appointment_status_form" />
        <field name="target">current</field>
        <field name="binding_model_id" ref="model_appointment_status" />
        <field name="binding_view_types">form</field>
    </record>

    <menuitem id="menu_appointment_status"
        sequence="20"
        parent="calendar.calendar_menu_config"
        action="action_appointment_status" />

    <record id="view_calendar_event_appointment_status_inherited_form" model="ir.ui.view">
        <field name="name">calendar.event.form.appointment.status</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form" />
        <field name="arch" type="xml">
            <field name="categ_ids" position="after">
                <field name="appointment_status_id" type="row" />
            </field>
        </field>
    </record>
    <record id="calendar_event_view_pivot_appointment_status_inherited" model="ir.ui.view">
        <field name="name">calendar.event.pivot.inherited</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="appointment.calendar_event_view_pivot" />
        <field name="arch" type="xml">
            <field name="start" position="after">
                <field name="appointment_status_id" type="row" />
            </field>
        </field>
    </record>
</odoo>