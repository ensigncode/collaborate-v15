<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_appointment_reason_tree" model="ir.ui.view">
        <field name="name">view.appointment.reason.tree</field>
        <field name="model">appointment.reason</field>
        <field name="arch" type="xml">
            <tree string="Appointment Reason">
                <field name="name" />
            </tree>
        </field>
    </record>
    <record id="view_appointment_reason_form" model="ir.ui.view">
        <field name="name">view.appointment.reason.form</field>
        <field name="model">appointment.reason</field>
        <field name="arch" type="xml">
            <form string="Appointment Reason">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_appointment_reason" model="ir.actions.act_window">
        <field name="name">Appointment Reason</field>
        <field name="res_model">appointment.reason</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="website_appointment_extend.view_appointment_reason_form" />
        <field name="target">current</field>
        <field name="binding_model_id" ref="model_appointment_reason" />
        <field name="binding_view_types">form</field>
    </record>

    <menuitem id="menu_appointment_reason"
        sequence="20"
        parent="calendar.calendar_menu_config"
        action="action_appointment_reason" />

    <record id="view_calendar_event_appointment_reason_inherited" model="ir.ui.view">
        <field name="name">calendar.event.form.appointment.reasons</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form" />
        <field name="arch" type="xml">
            <field name="categ_ids" position="after">
                <field name="appintment_reason_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>
    <record id="calendar_event_view_pivot_inherited" model="ir.ui.view">
        <field name="name">calendar.event.pivot.inherited</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="appointment.calendar_event_view_pivot" />
        <field name="arch" type="xml">
            <field name="start" position="after">
                <field name="appintment_reason_ids" type="row" />
                <field name="appintment_reason_names" type="row" />
            </field>
        </field>
    </record>
</odoo>