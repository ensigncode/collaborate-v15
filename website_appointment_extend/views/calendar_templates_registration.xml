<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <template id="inherit_appointment_form" inherit_id="appointment.appointment_form">
            <xpath expr="//div[hasclass('checkbox')]" position="replace">
                <div class="checkbox" t-foreach="question.answer_ids or []" t-as="answer">
                    <label>
                        <t t-if="'newsletter' in question.name.lower()">
                            <t t-if="env.user and env.user.partner_id.subscribed_to_newsletter">
                                <t t-if="answer.name.lower() in ['Yes','yes','YES','Subscribe','subscribe','SUBSCRIBE','True','true','TRUE']">
                                    <input type="radio" t-attf-name="question_#{question.id}" t-att-required="question.question_required or None" t-att-value="answer.name" class="mr-1" checked="checked"/>
                                    <t t-out="answer.name"/>
                                </t>
                                <t t-if="answer.name.lower() in ['No','no','NO','Unsubscribe','unsubscribe','UNSUBSCRIBE','False','false','FALSE']">
                                    <input type="radio" t-attf-name="question_#{question.id}" t-att-required="question.question_required or None" t-att-value="answer.name" class="mr-1"/>
                                    <t t-out="answer.name"/>
                                </t>
                            </t>
                            <t t-if="env.user and not env.user.partner_id.subscribed_to_newsletter">
                                <t t-if="answer.name.lower() in ['Yes','yes','YES','Subscribe','subscribe','SUBSCRIBE','True','true','TRUE']">
                                    <input type="radio" t-attf-name="question_#{question.id}" t-att-required="question.question_required or None" t-att-value="answer.name" class="mr-1"/>
                                    <t t-out="answer.name"/>
                                </t>
                                <t t-if="answer.name.lower() in ['No','no','NO','Unsubscribe','unsubscribe','UNSUBSCRIBE','False','false','FALSE']">
                                    <input type="radio" t-attf-name="question_#{question.id}" t-att-required="question.question_required or None" t-att-value="answer.name" class="mr-1" checked="checked"/>
                                    <t t-out="answer.name"/>
                                </t>
                            </t>
                        </t>
                        <t t-elif="'sms' in question.name.lower()">
                            <t t-if="env.user and env.user.partner_id.subscribed_to_sms">
                                <t t-if="answer.name.lower() in ['Yes','yes','YES','Subscribe','subscribe','SUBSCRIBE','True','true','TRUE']">
                                    <input type="radio" t-attf-name="question_#{question.id}" t-att-required="question.question_required or None" t-att-value="answer.name" class="mr-1" checked="checked"/>
                                    <t t-out="answer.name"/>
                                </t>
                                <t t-if="answer.name.lower() in ['No','no','NO','Unsubscribe','unsubscribe','UNSUBSCRIBE','False','false','FALSE']">
                                    <input type="radio" t-attf-name="question_#{question.id}" t-att-required="question.question_required or None" t-att-value="answer.name" class="mr-1"/>
                                    <t t-out="answer.name"/>
                                </t>
                            </t>
                            <t t-if="env.user and not env.user.partner_id.subscribed_to_sms">
                                <t t-if="answer.name.lower() in ['Yes','yes','YES','Subscribe','subscribe','SUBSCRIBE','True','true','TRUE']">
                                    <input type="radio" t-attf-name="question_#{question.id}" t-att-required="question.question_required or None" t-att-value="answer.name" class="mr-1"/>
                                    <t t-out="answer.name"/>
                                </t>
                                <t t-if="answer.name.lower() in ['No','no','NO','Unsubscribe','unsubscribe','UNSUBSCRIBE','False','false','FALSE']">
                                    <input type="radio" t-attf-name="question_#{question.id}" t-att-required="question.question_required or None" t-att-value="answer.name" class="mr-1" checked="checked"/>
                                    <t t-out="answer.name"/>
                                </t>
                            </t>
                        </t>
                        <t t-else="">
                            <label>
                                <input type="radio" t-attf-name="question_#{question.id}" t-att-required="question.question_required or None" t-att-value="answer.name" class="mr-1"/>
                                <t t-out="answer.name"/>
                            </label>
                        </t>
                    </label>
                </div>
            </xpath>
        </template>

    </data>


</odoo>
