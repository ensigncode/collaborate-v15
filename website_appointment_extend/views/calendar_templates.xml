<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="appointment_select_sequence" inherit_id="appointment.appointment_calendar">
            <xpath expr="//div[@t-foreach='slots']" position="attributes">
                <attribute name="t-attf-class">o_appointment_month px-1 px-md-3 #{month['calendar_class']}</attribute>
            </xpath>
            <xpath expr="//div[@t-foreach='slots']//table//tr[hasclass('o_appointment_days')]//td" position="attributes">
                <attribute name="t-attf-class">align-middle p-md-2 p-1 text-center#{day['weekend_cls'] == None and ' o_day'} #{day['weekend_cls']} #{day['today_cls']}</attribute>
            </xpath>
            <xpath expr="//div[@t-foreach='slots']//table//tr[hasclass('o_appointment_days')]//td//t[2]/div" position="attributes">
                <attribute name="t-att-id">day['day']</attribute>
            </xpath>
        </template>

    </data>
</odoo>